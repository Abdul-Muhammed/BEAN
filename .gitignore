# dependencies
node_modules/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native
# Both platforms are generated by prebuild (Continuous Native Generation), so
# the folders are build output, not source. Committing them makes EAS skip
# syncing app.json / app.config.js native config, which silently drops things
# like the Android googleMaps key.
/android
/ios
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macos
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
